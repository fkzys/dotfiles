#!/usr/bin/env bash
{{ $s := output "sops" "-d" (joinPath .sourceDir "secrets.enc.yaml") | fromYaml -}}
{{ $url := index $s "sing-box" "config_url" .hostname -}}

show_help() {
    cat <<EOF
Usage: $(basename "$0") [OPTION]

Run sing-box with per-host config downloaded from secrets.

Options:
  -h, --help  Show this help message and exit

Without options, downloads config (if available) and starts sing-box.
EOF
}

case "${1:-}" in
    -h|--help)
        show_help
        ;;
    "")
        CONFIG="/opt/sing-box/config.json"
        TEMP=$(mktemp)

        # -f = fail on HTTP errors (4xx, 5xx)
        # -s = silent, -S = show errors
        if curl -fsSL "{{ $url }}" -o "${TEMP}"; then
            if cp "${TEMP}" "$CONFIG"; then
                echo -e "Config updated"
                rm -f "${TEMP}"
            else
                echo "Failed to copy config, exiting..." >&2
                rm -f "${TEMP}"
                exit 1
            fi
        else
            rm -f "${TEMP}"
            echo "Load failed, using old config"
        fi

        trap 'systemctl stop sing-box' EXIT SIGHUP SIGINT SIGTERM

        systemctl start sing-box ;
        echo -e "namespace ping\n" | systemd-cat --namespace=sing-box ;
        sleep 0.1 ;
        journalctl -a --namespace=sing-box -f &
        wait
        ;;
    *)
        echo "Unknown option: $1" >&2
        show_help >&2
        exit 1
        ;;
esac
