#!/usr/bin/env bash
set -euo pipefail
_src() { local p; p=$(verify-lib "$1" "$2") && . "$p" || exit 1; }
_src /usr/lib/bwrap-common/bwrap-common.sh /usr/lib/bwrap-common/

PROG=${1:?usage: wrapper FILE [ARGS...]}
shift

FILE_BINDS=(); PROG_ARGS=()
bwrap_resolve_files FILE_BINDS PROG_ARGS --ro-bind "$PROG"

A=()
bwrap_base A
bwrap_lib64 A
bwrap_resolv A
bwrap_runtime_dir A
bwrap_home_tmpfs A
A+=("${FILE_BINDS[@]}")
A+=(--ro-bind "$PWD" "$PWD" --chdir "$PWD")
bwrap_env_base A
bwrap_hardened_malloc A default
bwrap_sandbox A yes

bwrap_exec "${A[@]}" -- "${PROG_ARGS[0]}" "$@"
