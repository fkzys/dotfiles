#!/usr/bin/env bash
set -euo pipefail
_src() { local p; p=$(verify-lib "$1" "$2") && . "$p" || exit 1; }
_src /usr/lib/bwrap-common/bwrap-common.sh /usr/lib/bwrap-common/

{{ $s := output "sops" "-d" (joinPath .sourceDir "secrets.enc.yaml") | fromYaml -}}
PROJECTS_DIR="{{ index $s "opencode" "projects_dir" | replace "$HOME" .homeDir -}}"

A=()
bwrap_gui_setup A yes no
bwrap_bind_dir A \
    "${HOME}/.omo" \
    "${HOME}/.local/share/opencode" \
    "${HOME}/.local/state/opencode" \
    "${HOME}/.cache/opencode" \
    "${HOME}/.config/opencode" \
    "$PROJECTS_DIR"

A+=(--ro-bind "${HOME}/.config/opencode/opencode.json" \
              "${HOME}/.config/opencode/opencode.json"

    --ro-bind "${HOME}/.local/share/opencode/auth.json" \
              "${HOME}/.local/share/opencode/auth.json")

bwrap_ro_bind_dir A  "${HOME}/.local/share/pnpm"

{{ range $s.opencode.tmpfs -}}
A+=(--tmpfs "${HOME}/{{ . }}")
{{ end -}}

bwrap_gui_finish A wayland yes default filtered no none

A+=(--setenv OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX "500000" \
    --setenv CODEGRAPH_ALLOW_UNSAFE_NODE "1" \
    --setenv PATH "${HOME}/.local/share/pnpm/bin:/usr/bin:/bin")

bwrap_exec "${A[@]}" -- /usr/bin/opencode "$@"
