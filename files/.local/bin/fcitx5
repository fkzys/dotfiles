#!/usr/bin/env bash
set -euo pipefail
_src() { local p; p=$(verify-lib "$1" "$2") && . "$p" || exit 1; }
_src /usr/lib/bwrap-common/bwrap-common.sh /usr/lib/bwrap-common/

FCITX_SOCK_DIR="/tmp/fcitx5-$(id -u)"
mkdir -p "$FCITX_SOCK_DIR"

A=()
bwrap_base A
bwrap_lib64 A
bwrap_runtime_dir A
bwrap_home_tmpfs A

bwrap_bind_dir A \
    "$FCITX_SOCK_DIR" \
    "${HOME}/.config/fcitx5" \
    "${HOME}/.local/share/fcitx5" \
    "${HOME}/.cache/fcitx5"

bwrap_themes A
bwrap_wayland A

bwrap_dbus_session A

bwrap_env_base A
A+=(
    --setenv QT_IM_MODULE fcitx
    --setenv XMODIFIERS "@im=fcitx"
)

bwrap_hardened_malloc A default
bwrap_sandbox A no

exec bwrap "${A[@]}" -- /usr/bin/fcitx5 "$@"
